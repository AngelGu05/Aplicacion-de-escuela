# Copia este archivo como .env.local (solo para pruebas en tu computadora).
# En Vercel ponlas en: Project → Settings → Environment Variables.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)  ¡NUNCA la compartas!
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
